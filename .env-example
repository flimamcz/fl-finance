NODE_ENV=development
PORT=5000

# Configure the database user/password to match your local MySQL setup.
MYSQL_USER=root
MYSQL_PASSWORD=replace-with-a-long-random-password
MYSQL_DATABASE=flp-finance
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# Generate a unique signing key (at least 32 random bytes) for this environment.
JWT_SECRET=replace-with-a-unique-random-secret

# Keep these loopback origins for local development; production should use its exact frontend origin(s).
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Set to 1 only when the API is behind a single trusted reverse proxy.
TRUST_PROXY=0
